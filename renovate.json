{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Frappe commit CI tests against",
      "managerFilePatterns": ["/^\\.github/versions\\.env$/"],
      "matchStrings": ["FRAPPE_BRANCH=(?<currentValue>\\S+)\\nFRAPPE_COMMIT=(?<currentDigest>[0-9a-f]{40})"],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "frappe",
      "packageNameTemplate": "https://github.com/frappe/frappe"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["frappe"],
      "automerge": false
    }
  ]
}
